# AntiDupeImage environment examples
# Copy to `.env` only for local shell use. Do not commit `.env`.
# All values below are placeholders or defaults; no secrets are included.

# Override the application data directory (database + api-token file).
# Default: data/ inside this repository (Windows and macOS).
# ANTIDUPEIMAGE_HOME=/path/to/antidupeimage-data

# Override only the SQLite database path.
# ANTIDUPEIMAGE_DB=/path/to/antidupeimage.sqlite3

# Provide the API token non-interactively for manual development servers.
# Generate one per shell, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# ANTIDUPEIMAGE_API_TOKEN=replace-with-a-random-token

# Trusted UI origin for manual development servers.
# ANTIDUPEIMAGE_UI_ORIGIN=http://127.0.0.1:5173

# One-time launcher handshake values (set automatically by launchers).
# ANTIDUPEIMAGE_LAUNCH_NONCE=replace-with-launcher-nonce
# ANTIDUPEIMAGE_HANDOFF_PATH=/path/to/antidupeimage-handoff.html

# Resource safety limits (defaults shown).
# ANTIDUPEIMAGE_THUMBNAIL_SIZE=384
# ANTIDUPEIMAGE_MAX_SCAN_PAGE_SIZE=200
# ANTIDUPEIMAGE_MAX_GROUP_PAGE_SIZE=500
# ANTIDUPEIMAGE_MAX_REQUEST_BODY_BYTES=1048576
# ANTIDUPEIMAGE_MAX_ANIMATION_FRAMES=1000
# ANTIDUPEIMAGE_MAX_DECODED_PIXELS=50000000
# ANTIDUPEIMAGE_MAX_CANDIDATE_PAIRS=100000
# ANTIDUPEIMAGE_MAX_CANDIDATE_COMPARISONS=1000000
# Example override; default is CPU-dependent, between 1 and 4.
# ANTIDUPEIMAGE_FEATURE_WORKERS=2

# Optional CLIP model defaults.
# ANTIDUPEIMAGE_CLIP_MODEL=ViT-B-32
# ANTIDUPEIMAGE_CLIP_PRETRAINED=laion2b_s34b_b79k
