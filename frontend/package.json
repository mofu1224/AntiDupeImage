{
  "name": "antidupeimage-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --configLoader runner",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
